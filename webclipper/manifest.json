{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save page to Notes"
  },
  "description": "Save a web page into your Notes app: it lands in the Notes folder in your Google Drive and appears in the app on every device.",
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "key": "",
  "manifest_version": 3,
  "name": "Notes Web Clipper",
  "oauth2": {
    "client_id": "1081680979454-jdadbf3njts0td6tgm5qd6pmiqfuqr16.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "permissions": [
    "identity",
    "scripting",
    "activeTab",
    "storage"
  ],
  "version": "1.0.0"
}
